# BARACAP runtime
PORT=8000
APP_HOST=0.0.0.0
FRONTEND_URL=http://127.0.0.1:8000

# Local development uses SQLite automatically when BARACAP_USE_POSTGRES is not 1.
# For production, set BARACAP_USE_POSTGRES=1 and provide a PostgreSQL URL.
BARACAP_USE_POSTGRES=0
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/baracap_db
AUTO_CREATE_TABLES=true

# Legacy auth values are not used by the current public test page.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEV_AUTH_ENABLED=false

# Telegram notification for literacy test results
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PDF guide links are optional. The current app generates browser-download PDFs.
SIMPLE_GUIDE_URL=
PROFESSIONAL_GUIDE_URL=

# Legacy Google value is kept only for old backend endpoints; the current public page does not use login.
GOOGLE_CLIENT_ID=
